<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-ios;net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FinanceApp.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

    <ApplicationTitle>Flaitt Finanças</ApplicationTitle>
    <ApplicationId>com.meucontrole.financas</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    EF Core 8 recusa construir o modelo em tempo de execução quando a plataforma não permite "código
    dinâmico" (AOT puro no iOS físico, por exemplo), e aí quebra com:
      "Model building is not supported when publishing with NativeAOT. Use a compiled model."
    Habilitar o interpretador do Mono no iOS resolve, com um pequeno custo de inicialização.
    Para Release otimizado, considerar gerar um modelo compilado via `dotnet ef dbcontext optimize`.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Reconhecimento de voz no dispositivo (sem rede) para o fluxo "ditar o gasto" -->
    <PackageReference Include="CommunityToolkit.Maui" Version="11.2.0" />
    <!-- Alinhado à versão do workload MAUI para evitar conflito de versões -->
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
    <!-- Logging de depuração usado em MauiProgram (builder.Logging.AddDebug) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
    <!-- SQLite nativo mais recente (EF Core 8 traz 2.1.6, sem alinhamento de 16 KB exigido pelo Android 16) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- Biometria (Face ID no iOS, digital no Android) para a trava de abertura -->
    <PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmas regras de negócio do backend, executadas localmente sobre SQLite no aparelho -->
    <ProjectReference Include="..\..\backend\src\FinanceApp.Domain\FinanceApp.Domain.csproj" />
    <ProjectReference Include="..\..\backend\src\FinanceApp.Application\FinanceApp.Application.csproj" />
    <ProjectReference Include="..\..\backend\src\FinanceApp.Infrastructure\FinanceApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D47A1" BaseSize="128,128" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
