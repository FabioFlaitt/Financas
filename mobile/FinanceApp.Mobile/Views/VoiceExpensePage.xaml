<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             x:Class="FinanceApp.Mobile.Views.VoiceExpensePage"
             x:DataType="vm:VoiceExpenseViewModel"
             Title="Ditar lançamento"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Microfone -->
            <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}"
                    Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" StrokeShape="RoundRectangle 20"
                    Padding="24" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Button Text="🎙️" FontSize="40" Command="{Binding ListenCommand}"
                            TextColor="White" CornerRadius="48" WidthRequest="96" HeightRequest="96"
                            Padding="0" HorizontalOptions="Center" BackgroundColor="#0D47A1">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsListening}" Value="True">
                                <Setter Property="BackgroundColor" Value="#C62828" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Text="{Binding Hint}" FontSize="13" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" />
                    <Label Text="{Binding Transcript}" FontSize="14" FontAttributes="Italic"
                           HorizontalTextAlignment="Center" IsVisible="{Binding Transcript, Converter={StaticResource IsNotNull}}"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                </VerticalStackLayout>
            </Border>

            <!-- Mensagens -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                    BackgroundColor="#FDECEA" Stroke="#C62828" StrokeShape="RoundRectangle 12" Padding="12">
                <Label Text="{Binding ErrorMessage}" TextColor="#8B1A12" />
            </Border>
            <Border IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNull}}"
                    BackgroundColor="#E8F5E9" Stroke="#2E7D32" StrokeShape="RoundRectangle 12" Padding="12">
                <Label Text="{Binding SuccessMessage}" TextColor="#1B5E20" />
            </Border>

            <!-- Rascunho (editável antes de salvar) -->
            <Border IsVisible="{Binding HasDraft}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}"
                    Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Confirme o lançamento" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />

                    <Label Text="Descrição" FontSize="11" TextColor="#6E6E6E" />
                    <Entry Text="{Binding Description}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Valor (R$)" FontSize="11" TextColor="#6E6E6E" />
                            <Entry Text="{Binding AmountText}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Data" FontSize="11" TextColor="#6E6E6E" />
                            <DatePicker Date="{Binding Date}" Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Categoria" FontSize="11" TextColor="#6E6E6E" />
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

                    <Label Text="Conta" FontSize="11" TextColor="#6E6E6E" />
                    <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" />

                    <Label Text="Forma de pagamento" FontSize="11" TextColor="#6E6E6E" />
                    <Picker ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" />

                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding IsIncome}" />
                        <Label Text="Isto é uma receita" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                    </HorizontalStackLayout>

                    <Button Text="Salvar" Command="{Binding SaveCommand}" BackgroundColor="#0D47A1"
                            TextColor="White" CornerRadius="12" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
