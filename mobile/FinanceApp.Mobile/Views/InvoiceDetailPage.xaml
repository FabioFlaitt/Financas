<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Mobile.Models"
             x:Class="FinanceApp.Mobile.Views.InvoiceDetailPage"
             x:DataType="vm:InvoiceDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                    BackgroundColor="#FDECEA" Stroke="#C62828" StrokeShape="RoundRectangle 10" Padding="12">
                <Label Text="{Binding ErrorMessage}" TextColor="#8B1A12" />
            </Border>

            <!-- Resumo da fatura -->
            <Border Padding="16" StrokeShape="RoundRectangle 14" BackgroundColor="#0D47A1">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding PeriodLabel}" FontSize="13" TextColor="#BBD4F5" VerticalOptions="Center" />
                        <Border Grid.Column="1" Padding="8,2" StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding StatusColorHex, Converter={StaticResource HexColor}}">
                            <Label Text="{Binding StatusLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding TotalLabel}" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <Label Grid.Column="0" Text="{Binding PaidLabel, StringFormat='Pago: {0}'}" FontSize="12" TextColor="#BBD4F5" />
                        <Label Grid.Column="1" Text="{Binding OutstandingLabel, StringFormat='Em aberto: {0}'}" FontSize="12"
                               HorizontalTextAlignment="End" TextColor="#BBD4F5" />
                    </Grid>
                    <Label Text="{Binding DueLabel}" FontSize="12" TextColor="#BBD4F5" />
                </VerticalStackLayout>
            </Border>

            <!-- Pagamento -->
            <Border IsVisible="{Binding CanPay}" Padding="14" StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pagar fatura" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                    <Label Text="Conta de pagamento" FontSize="12" TextColor="#6E6E6E" />
                    <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" />
                    <Label Text="Valor (R$)" FontSize="12" TextColor="#6E6E6E" />
                    <Entry Text="{Binding PayAmountText}" Keyboard="Numeric" />
                    <Button Text="Pagar" Command="{Binding PayCommand}" BackgroundColor="#2E7D32" TextColor="White" CornerRadius="12" />
                    <Button Text="Fechar fatura" Command="{Binding CloseCommand}"
                            BackgroundColor="Transparent" TextColor="#0D47A1" BorderColor="#0D47A1" BorderWidth="1" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Compras -->
            <Label Text="Compras" FontSize="16" FontAttributes="Bold" Margin="4,4,4,0"
                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
            <Border Padding="4" StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transactions}" Spacing="0">
                    <BindableLayout.EmptyView>
                        <Label Text="Sem compras nesta fatura." FontSize="12" Padding="12" TextColor="#919191" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:InvoiceTransaction">
                            <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="10" Padding="10,10">
                                <BoxView Grid.Column="0" CornerRadius="3" VerticalOptions="Fill"
                                         Color="{Binding CategoryColorHex, Converter={StaticResource HexColor}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="{Binding Description}" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                                    <Label Text="{Binding TransactionDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="11" TextColor="#919191" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" VerticalOptions="Center" FontAttributes="Bold"
                                       Text="{Binding Amount, Converter={StaticResource Currency}}" TextColor="#C62828" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0D47A1" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
