<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Mobile.Models"
             x:Class="FinanceApp.Mobile.Views.TripsPage"
             x:DataType="vm:TripsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nova viagem" Clicked="OnNewClicked" />
        <ToolbarItem Text="Excluídas" Clicked="OnToggleDeleted" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" IsVisible="{Binding HasError}" Margin="16,12,16,0"
                BackgroundColor="#FDECEA" Stroke="#C62828" StrokeShape="RoundRectangle 10" Padding="12">
            <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="#8B1A12" />
        </Border>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Trips}" SelectionMode="None" Margin="0,8,0,0">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" VerticalOptions="Center" Spacing="8">
                        <Label Text="🚗" FontSize="46" HorizontalOptions="Center" />
                        <Label Text="Nenhuma viagem ainda" HorizontalOptions="Center" TextColor="#6E6E6E" />
                        <Label Text="Toque em “Nova viagem” para começar a mapear pedágios, km e combustível."
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="12" TextColor="#919191" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TripDto">
                        <Border Margin="16,6" BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}"
                                Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" StrokeShape="RoundRectangle 14" Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTripTapped" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                                    <Label Text="{Binding RouteLabel}" FontSize="12" TextColor="#6E6E6E"
                                           IsVisible="{Binding RouteLabel, Converter={StaticResource IsNotNull}}" />
                                    <Label Text="{Binding StatusLabel}" FontSize="11" TextColor="#919191" />
                                </VerticalStackLayout>
                                <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Center"
                                       Text="{Binding Summary.TotalCost, Converter={StaticResource Currency}}"
                                       FontAttributes="Bold" TextColor="#0D47A1" />
                                <Button Grid.Row="0" Grid.Column="2" Text="⋮" FontSize="20" Padding="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="Transparent" TextColor="#6E6E6E" VerticalOptions="Center"
                                        Clicked="OnTripMenu" CommandParameter="{Binding .}" />
                                <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" Spacing="16">
                                    <Label FontSize="12" TextColor="#6E6E6E"
                                           Text="{Binding Summary.DistanceKm, StringFormat='{0:N1} km'}" />
                                    <Label FontSize="12" TextColor="#6E6E6E"
                                           Text="{Binding Summary.CostPerKm, Converter={StaticResource Currency}}" />
                                    <Label FontSize="12" TextColor="#6E6E6E"
                                           Text="{Binding Summary.TollTotal, Converter={StaticResource Currency}, StringFormat='Pedágios: {0}'}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
