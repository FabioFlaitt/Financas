<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Mobile.Models"
             x:Class="FinanceApp.Mobile.Views.ChartsPage"
             x:DataType="vm:ChartsViewModel"
             Title="Gráficos"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1B1F24}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="4,8,4,4" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Navegador de mês -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Button Grid.Column="0" Text="‹" FontSize="20" WidthRequest="44" HeightRequest="40"
                            Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}"
                            Command="{Binding PreviousMonthCommand}" />
                    <Label Grid.Column="1" Text="{Binding MonthLabel}" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}" />
                    <Button Grid.Column="2" Text="›" FontSize="20" WidthRequest="44" HeightRequest="40"
                            Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}"
                            Command="{Binding NextMonthCommand}" />
                </Grid>

                <!-- KPIs do mês -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Receitas" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding IncomeLabel}" FontSize="14" FontAttributes="Bold" TextColor="#2E7D32" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding ExpenseLabel}" FontSize="14" FontAttributes="Bold" TextColor="#C62828" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Resultado" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding ResultLabel}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{Binding Result, Converter={StaticResource AmountColor}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Receitas x despesas por mês -->
                <Label Text="Receitas x despesas (6 meses)" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <GraphicsView Drawable="{Binding MonthlySeriesChart}" HeightRequest="180" />
                        <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="#2E7D32" VerticalOptions="Center" />
                                <Label Text="Receitas" FontSize="11" Style="{StaticResource CardLabel}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5">
                                <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="#C62828" VerticalOptions="Center" />
                                <Label Text="Despesas" FontSize="11" Style="{StaticResource CardLabel}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Despesas por categoria -->
                <Label Text="Despesas por categoria" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                        <GraphicsView Grid.Column="0" Drawable="{Binding CategoryChart}" HeightRequest="150" WidthRequest="150" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center"
                                             BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.EmptyView>
                                <Label Text="Sem despesas no mês." FontSize="12" Style="{StaticResource CardLabel}" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategorySlice">
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3"
                                                 Color="{Binding ColorHex, Converter={StaticResource HexColor}}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding CategoryName}" FontSize="13" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Percent, Converter={StaticResource Percent}}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Fixas x variáveis -->
                <Label Text="Gastos fixos x variáveis" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                        <GraphicsView Grid.Column="0" Drawable="{Binding FixedVariableChart}" HeightRequest="150" WidthRequest="150" />
                        <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="#1565C0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Fixas" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                                <Label Grid.Column="2" Text="{Binding FixedLabel}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                            </Grid>
                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                                <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3" Color="#EF6C00" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Variáveis" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                                <Label Grid.Column="2" Text="{Binding VariableLabel}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Puxe para baixo para atualizar." FontSize="11" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#919191, Dark=#6E6E6E}" Margin="0,4,0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
