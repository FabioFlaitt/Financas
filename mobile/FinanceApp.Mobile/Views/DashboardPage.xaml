<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Mobile.Models"
             x:Class="FinanceApp.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Painel"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1B1F24}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" />
        </Style>
        <Style x:Key="CardValue" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="4,8,4,4" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout>
                        <Label Text="{Binding Greeting}" FontSize="22" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}" />
                        <Label Text="{Binding MonthLabel}" Style="{StaticResource CardLabel}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" IsVisible="{Binding IsDemo}"
                            BackgroundColor="#FFF3CD" Stroke="#F9A825" StrokeShape="RoundRectangle 8"
                            Padding="8,4" VerticalOptions="Center">
                        <Label Text="DEMONSTRAÇÃO" FontSize="10" FontAttributes="Bold" TextColor="#8A6D00" />
                    </Border>
                </Grid>

                <!-- Erro -->
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FDECEA" Stroke="#C62828"
                        StrokeShape="RoundRectangle 12" Padding="14">
                    <Label Text="{Binding ErrorMessage}" TextColor="#8B1A12" />
                </Border>

                <!-- Saldo total em destaque -->
                <Border Style="{StaticResource Card}" BackgroundColor="{AppThemeBinding Light=#0D47A1, Dark=#13294B}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Saldo total das contas" FontSize="12" TextColor="#BBD4F5" />
                        <Label Text="{Binding Dashboard.TotalBalance, Converter={StaticResource Currency}}"
                               FontSize="30" FontAttributes="Bold" TextColor="White" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Projeção fim do mês:" FontSize="12" TextColor="#BBD4F5" />
                            <Label Text="{Binding Dashboard.ProjectedEndOfMonthBalance, Converter={StaticResource Currency}}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#BBD4F5" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- KPIs principais -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Receitas do mês" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.MonthIncome, Converter={StaticResource Currency}}"
                                   Style="{StaticResource CardValue}" TextColor="#2E7D32" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas do mês" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.MonthExpense, Converter={StaticResource Currency}}"
                                   Style="{StaticResource CardValue}" TextColor="#C62828" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Resultado do mês" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.MonthResult, Converter={StaticResource SignedCurrency}}"
                                   Style="{StaticResource CardValue}"
                                   TextColor="{Binding Dashboard.MonthResult, Converter={StaticResource AmountColor}}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Faturas em aberto" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.OpenInvoicesTotal, Converter={StaticResource Currency}}"
                                   Style="{StaticResource CardValue}" TextColor="#6A1B9A" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Renda comprometida" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.CommittedIncomePercent, Converter={StaticResource Percent}}"
                                   Style="{StaticResource CardValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas vs. mês anterior" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.ExpenseVsPreviousMonthPercent, Converter={StaticResource Percent}}"
                                   Style="{StaticResource CardValue}"
                                   TextColor="{Binding Dashboard.ExpenseVsPreviousMonthPercent, Converter={StaticResource AmountColor}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas realizadas" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.RealizedExpenses, Converter={StaticResource Currency}}"
                                   Style="{StaticResource CardValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Despesas previstas" Style="{StaticResource CardLabel}" />
                            <Label Text="{Binding Dashboard.ForecastExpenses, Converter={StaticResource Currency}}"
                                   Style="{StaticResource CardValue}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Evolução do saldo -->
                <Label Text="Evolução do saldo no mês" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <GraphicsView Drawable="{Binding BalanceChart}" HeightRequest="170" />
                </Border>

                <!-- Despesas por categoria -->
                <Label Text="Despesas por categoria" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                        <GraphicsView Grid.Column="0" Drawable="{Binding CategoryChart}" HeightRequest="150" WidthRequest="150" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center"
                                             BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategorySlice">
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="3"
                                                 Color="{Binding ColorHex, Converter={StaticResource HexColor}}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding CategoryName}" FontSize="13" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Percent, Converter={StaticResource Percent}}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Maiores despesas -->
                <Label Text="Maiores despesas do mês" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="8">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopExpenses}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TopExpenseItem">
                                <Grid ColumnDefinitions="*,Auto" Padding="8,10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Description}" FontSize="14"
                                               TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                                        <Label Text="{Binding CategoryName}" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Currency}}"
                                           FontSize="14" FontAttributes="Bold" TextColor="#C62828" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Puxe para baixo para atualizar." FontSize="11" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light=#919191, Dark=#6E6E6E}" Margin="0,4,0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
