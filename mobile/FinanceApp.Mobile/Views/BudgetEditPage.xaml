<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             x:Class="FinanceApp.Mobile.Views.BudgetEditPage"
             x:DataType="vm:BudgetEditViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"
                    BackgroundColor="#FDECEA" Stroke="#C62828" StrokeShape="RoundRectangle 10" Padding="12">
                <Label Text="{Binding ErrorMessage}" TextColor="#8B1A12" />
            </Border>

            <Label Text="Período" FontSize="12" TextColor="#6E6E6E" />
            <Label Text="{Binding PeriodLabel}" FontSize="16" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}" />

            <Label Text="Escopo" FontSize="12" TextColor="#6E6E6E" />
            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="Limite (R$)" FontSize="12" TextColor="#6E6E6E" />
            <Entry Text="{Binding LimitText}" Keyboard="Numeric" Placeholder="Ex.: 1.500,00" />

            <Label Text="{Binding AlertThresholdLabel}" FontSize="12" TextColor="#6E6E6E" />
            <Stepper Minimum="50" Maximum="100" Increment="5" Value="{Binding AlertThreshold}" HorizontalOptions="Start" />

            <Button Text="Salvar" Command="{Binding SaveCommand}" BackgroundColor="#0D47A1" TextColor="White" CornerRadius="12" Margin="0,8,0,0" />
            <Button Text="Excluir" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}"
                    BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#C62828" BorderWidth="1" CornerRadius="12" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0D47A1" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
