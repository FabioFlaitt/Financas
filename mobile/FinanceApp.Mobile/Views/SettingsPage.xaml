<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceApp.Mobile.Views.SettingsPage"
             Title="Config."
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ContentPage.Resources>
        <Style x:Key="GroupTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="6,14,6,2" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#6E6E6E, Dark=#9AA4AF}" />
        </Style>
        <Style x:Key="NavRow" TargetType="Grid">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ColumnDefinitions" Value="34,*,Auto" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1B1F24}" />
        </Style>
        <Style x:Key="NavIcon" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="NavText" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
        </Style>
        <Style x:Key="NavChevron" TargetType="Label">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="#B0B6BD" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="4">

            <!-- Cabeçalho da sessão -->
            <Border Padding="16" BackgroundColor="#0D47A1" StrokeShape="RoundRectangle 14" Margin="0,4,0,4">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Perfil" FontSize="12" TextColor="#BBD4F5" />
                        <Label Text="Flaitt Finanças" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Seus dados ficam salvos no seu celular" FontSize="11" TextColor="#BBD4F5" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#1B5E20" StrokeShape="RoundRectangle 8"
                            Padding="8,4" VerticalOptions="Center">
                        <Label Text="🔒 SÓ NESTE APARELHO" FontSize="10" FontAttributes="Bold" TextColor="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Cadastros -->
            <Label Text="CADASTROS" Style="{StaticResource GroupTitle}" />
            <Border StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" Padding="0">
                <VerticalStackLayout Spacing="1" BackgroundColor="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}">
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAccountsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🏦" Style="{StaticResource NavIcon}" />
                        <Label Grid.Column="1" Text="Contas" Style="{StaticResource NavText}" />
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoriesTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🏷️" Style="{StaticResource NavIcon}" />
                        <Label Grid.Column="1" Text="Categorias" Style="{StaticResource NavText}" />
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecurringTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🔁" Style="{StaticResource NavIcon}" />
                        <Label Grid.Column="1" Text="Recorrências" Style="{StaticResource NavText}" />
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Planejamento -->
            <Label Text="PLANEJAMENTO" Style="{StaticResource GroupTitle}" />
            <Border StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" Padding="0">
                <VerticalStackLayout Spacing="1" BackgroundColor="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}">
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBudgetTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🎯" Style="{StaticResource NavIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Orçamento mensal" Style="{StaticResource NavText}" />
                            <Label Text="Limites por categoria e acompanhamento" FontSize="11" TextColor="#919191" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Ferramentas -->
            <Label Text="FERRAMENTAS" Style="{StaticResource GroupTitle}" />
            <Border StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}" Padding="0">
                <VerticalStackLayout Spacing="1" BackgroundColor="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}">
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🔔" Style="{StaticResource NavIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Alertas e notificações" Style="{StaticResource NavText}" />
                            <Label Text="Avisos e preferências" FontSize="11" TextColor="#919191" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTripsTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🚗" Style="{StaticResource NavIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Viagens" Style="{StaticResource NavText}" />
                            <Label Text="Despesas de viagem com rota por GPS" FontSize="11" TextColor="#919191" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackupTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🌐" Style="{StaticResource NavIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Backup dos dados" Style="{StaticResource NavText}" />
                            <Label Text="Exportar uma cópia dos dados do aparelho" FontSize="11" TextColor="#919191" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                    <Grid Style="{StaticResource NavRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnImportTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="📥" Style="{StaticResource NavIcon}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Importar extrato" Style="{StaticResource NavText}" />
                            <Label Text="CSV ou OFX, sem duplicar lançamentos" FontSize="11" TextColor="#919191" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource NavChevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sobre -->
            <Label Text="SOBRE" Style="{StaticResource GroupTitle}" />
            <Border StrokeShape="RoundRectangle 14" Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Flaitt Finanças" FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                    <Label x:Name="VersionLabel" Text="Versão 1.0" FontSize="12" TextColor="#919191" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
