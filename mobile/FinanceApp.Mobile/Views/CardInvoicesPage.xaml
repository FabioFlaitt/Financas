<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FinanceApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:FinanceApp.Mobile.Models"
             x:Class="FinanceApp.Mobile.Views.CardInvoicesPage"
             x:DataType="vm:CardInvoicesViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#101317}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Parcelar" Clicked="OnInstallmentClicked" />
        <ToolbarItem Text="Editar" Clicked="OnEditClicked" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" VerticalOptions="Center" Spacing="6">
                    <Label Text="🧾" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Nenhuma fatura ainda" HorizontalOptions="Center" TextColor="#6E6E6E" />
                    <Label Text="Compras no cartão aparecerão aqui agrupadas por fatura." FontSize="12"
                           HorizontalTextAlignment="Center" HorizontalOptions="Center" TextColor="#919191" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:InvoiceListItem">
                    <Border Margin="12,6" Padding="14" StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light=#E6E8EC, Dark=#2A2F36}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1F24}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInvoiceTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ReferenceMonth, StringFormat='Fatura {0:MM/yyyy}'}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                            <Border Grid.Row="0" Grid.Column="1" Padding="8,2" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{Binding StatusColorHex, Converter={StaticResource HexColor}}">
                                <Label Text="{Binding StatusLabel}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding TotalAmount, Converter={StaticResource Currency}}"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#F5F7FA}" />
                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding OutstandingAmount, Converter={StaticResource Currency}, StringFormat='Em aberto: {0}'}"
                                   FontSize="12" TextColor="#919191" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DueDate, StringFormat='Vence {0:dd/MM}'}"
                                   FontSize="12" TextColor="#919191" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
